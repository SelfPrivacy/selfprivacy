require 'etc'
require 'securerandom'

default_platform(:android)

platform :android do
  desc 'Upload the signed production AAB to the Google Play internal track'
  lane :upload_internal do
    upload_to_play_store(
      package_name: 'org.selfprivacy.app',
      aab: ENV.fetch('AAB_PATH'),
      json_key: ENV.fetch('PLAY_JSON_KEY_FILE'),
      track: 'internal',
      release_status: 'completed',
      skip_upload_apk: true,
      # Metadata in fastlane/metadata/android is F-Droid's copy and is stale;
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )
  end
end

platform :ios do
  desc 'Re-sign the unsigned Runner.xcarchive and export an App Store IPA'
  lane :sign_release do
    ENV['HOME'] = Etc.getpwuid(Process.uid).dir
    keychain_name = "selfprivacy-sign-#{SecureRandom.uuid}"
    keychain_password = SecureRandom.hex(16)
    create_keychain(
      name: keychain_name,
      password: keychain_password,
      unlock: true,
      timeout: 0,
      lock_when_sleeps: false,
      add_to_search_list: true
    )
    begin
      match(
        type: 'appstore',
        app_identifier: 'org.selfprivacy.app',
        git_url: ENV.fetch('MATCH_GIT_URL'),
        readonly: true,
        keychain_name: keychain_name,
        keychain_password: keychain_password
      )
      frameworks = File.join(
        ENV.fetch('XCARCHIVE_PATH'),
        'Products/Applications/Runner.app/Frameworks/*.framework'
      )
      Dir.glob(frameworks).each do |framework|
        sh('codesign', '--force', '--sign', '-', framework)
      end

      build_app(
        workspace: File.expand_path('../ios/Runner.xcworkspace', __dir__),
        scheme: 'Runner',
        skip_build_archive: true,
        archive_path: ENV.fetch('XCARCHIVE_PATH'),
        export_method: 'app-store',
        export_team_id: ENV.fetch('sigh_org.selfprivacy.app_appstore_team-id'),
        export_options: {
          signingStyle: 'manual',
          provisioningProfiles: lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
        },
        output_directory: ENV.fetch('IPA_OUTPUT_DIR'),
        output_name: 'selfprivacy-ios-signed'
      )
    ensure
      begin
        delete_keychain(name: keychain_name)
      rescue StandardError
      end
    end
  end

  desc 'Upload the signed IPA to TestFlight'
  lane :upload_testflight do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch('ASC_KEY_ID'),
      issuer_id: ENV.fetch('ASC_ISSUER_ID'),
      key_filepath: ENV.fetch('ASC_KEY_P8_FILE')
    )
    upload_to_testflight(
      api_key: api_key,
      ipa: ENV.fetch('IPA_PATH'),
      # don't burn runner time on Apple's processing queue
      skip_waiting_for_build_processing: true
    )
  end
end
