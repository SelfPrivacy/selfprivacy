{
  "GetTelemetrySettings": {
    "__typename": "Query",
    "system": {
      "__typename": "System",
      "settings": {
        "__typename": "SystemSettings",
        "openTelemetry": {
          "__typename": "OpenTelemetrySettings",
          "enable": false,
          "endpoint": "https://collector.example.org:4317",
          "uploadSystemLogs": false,
          "uploadSystemMetrics": true,
          "headerNames": [
            "authorization",
            "obsolete"
          ],
          "memoryTracingEnabled": false
        }
      }
    }
  },
  "SetTelemetrySettings": {
    "__typename": "Mutation",
    "system": {
      "__typename": "SystemMutations",
      "changeOpenTelemetrySettings": {
        "__typename": "OpenTelemetrySettingsMutationReturn",
        "success": true,
        "message": "OpenTelemetry settings changed",
        "code": 200,
        "settings": {
          "__typename": "OpenTelemetrySettings",
          "enable": true,
          "endpoint": "https://collector.example.org:4317",
          "uploadSystemLogs": false,
          "uploadSystemMetrics": true,
          "headerNames": [
            "authorization"
          ],
          "memoryTracingEnabled": false
        }
      }
    }
  }
}
